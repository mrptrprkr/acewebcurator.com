crash.log
crash.*.log

# Terraform CLI configuration
.terraformrc
terraform.rc

# Environment / secret files
.env
.env.*
*.pem
*.key

# OS / IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
terraform-old-storage/

# Local Terraform generated files
tfplan
**/tfplan
